{
  "name": "pitaya-convert",
  "version": "0.1.0-beta.2",
  "description": "Pitaya Convert - konwerter wideo, audio i grafiki",
  "author": "Pitayas <inbox@rakunek.com>",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build:win": "electron-builder --win",
    "build:linux": "electron-builder --linux",
    "build:all": "electron-builder -wl",
    "test": "node test/run-tests.js",
    "test:electron": "electron --no-sandbox test/electron-smoke.js"
  },
  "dependencies": {
    "ffmpeg-static": "^5.2.0",
    "sharp": "^0.34.5"
  },
  "devDependencies": {
    "electron": "^32.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.pitayas.convert",
    "productName": "Pitaya-Convert",
    "directories": {
      "output": "dist"
    },
    "files": [
      "**/*",
      "!dist/**",
      "!images/**",
      "!icon_backup.ico",
      "!test/**"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "icon.ico"
    },
    "linux": {
      "target": [
        "AppImage",
        "rpm"
      ],
      "executableName": "pitaya-convert",
      "category": "AudioVideo",
      "icon": "icon.png",
      "maintainer": "Pitayas <inbox@rakunek.com>"
    },
    "rpm": {
      "packageName": "pitaya-convert",
      "fpm": [
        "--rpm-compression",
        "none",
        "--replaces=mango-convert"
      ],
      "artifactName": "pitaya-convert-${version}.${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "artifactName": "PitayaConvert-Setup-${version}.${ext}"
    },
    "asarUnpack": [
      "node_modules/ffmpeg-static/**",
      "node_modules/sharp/**",
      "node_modules/@img/**"
    ],
    "appImage": {
      "artifactName": "PitayaConvert-${version}-${arch}.${ext}"
    },
    "copyright": "Copyright © 2026 Pitayas"
  },
  "allowScripts": {
    "electron@32.3.3": true,
    "ffmpeg-static@5.3.0": true
  },
  "homepage": "https://github.com/MangoLabz/Pitayas-Convert"
}
